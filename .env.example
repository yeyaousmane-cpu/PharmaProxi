# ---------------------------------------------------------------------------
# PharmaProxi — variables d'environnement (copier en .env.local)
# Aucune valeur réelle ne doit être commitée.
# ---------------------------------------------------------------------------

# URL publique de l'application (sans barre finale)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Projet Supabase : Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle-anon-publique

# Clé « service_role » : SERVEUR UNIQUEMENT (jamais préfixée NEXT_PUBLIC_).
# RECOMMANDÉE en production : limitation de débit partagée entre toutes les
# instances (sans elle, chaque instance compte séparément), route
# /api/cron/maintenance, suppression définitive des comptes, script de démonstration.
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé pour l'appel de /api/cron/maintenance (Vercel Cron ou autre).
CRON_SECRET=

# Délai maximum (ms) d'un appel à Supabase avant abandon (défaut : 10000).
SUPABASE_TIMEOUT_MS=10000

# Environnement : development | staging | production
# En production, le script de démonstration refuse de s'exécuter.
APP_ENV=development

# Mot de passe des comptes de démonstration (généré aléatoirement si vide).
DEMO_PASSWORD=

# Assistant santé (IA Claude d'Anthropic) — clé SECRÈTE, jamais en NEXT_PUBLIC_.
# Sans clé, la page /assistant affiche « bientôt disponible ».
ANTHROPIC_API_KEY=
# Facultatif : modèle (défaut claude-sonnet-5-5), limites par appareil et par jour.
ASSISTANT_MODEL=
ASSISTANT_HOURLY_LIMIT=20
ASSISTANT_DAILY_LIMIT=2000

# Envoi d'e-mails (annonces, bienvenue) — valeurs secrètes, jamais en NEXT_PUBLIC_
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
